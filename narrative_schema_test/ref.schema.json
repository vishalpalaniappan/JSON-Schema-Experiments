{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./items.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "string"
    },
    "narrative": {
        "$ref": "#/$defs/recursiveObjectCheck"
    }
  },
  "additionalProperties": false,
  "required": [
    "$schema",
    "metadata",
    "narrative"
  ],
  "$defs": {
    "recursiveObjectCheck": {
      "anyOf": [
        {
          "type": "object",
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": { "const": "behavior" }
                },
                "required": ["type"]
              },
              "then": {
                "$ref": "./behavior.schema.json"
              }
            },
            {
              "if": {
                "properties": {
                  "type": { "const": "participant" }
                },
                "required": ["type"]
              },
              "then": {
                "$ref": "./participant.schema.json"
              }
            }
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/recursiveObjectCheck" }
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/recursiveObjectCheck"
          }
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/recursiveObjectCheck" }
        },
        {
          "type": ["string", "number", "boolean", "null"]
        }
      ]
    }
  }
}