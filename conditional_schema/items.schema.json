{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./items.json",
    "type": "object",
    "properties": {
        "items": {
            "type": "array",
            "items": {
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "car"
                                }
                            },
                            "required": [
                                "type"
                            ]
                        },
                        "then": {
                            "$ref": "./car.schema.json"
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "book"
                                }
                            },
                            "required": [
                                "type"
                            ]
                        },
                        "then": {
                            "$ref": "./book.schema.json"
                        }
                    }
                ]
            }
        }
    }
}